S3_REGION="eu-west-3"
S3_BUCKET="memora-photos"
S3_ACCESS_KEY="memora"
S3_SECRET_KEY="memora-secret"

# --- Authentification ---
JWT_ACCESS_SECRET="change-moi-en-production"
JWT_REFRESH_SECRET="change-moi-aussi"
GUEST_SESSION_SECRET="et-moi-aussi"

# --- Paiement ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Serveur ---
PORT=3000
CLIENT_URL="http://localhost:5173"
