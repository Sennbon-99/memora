# --- Base de donnees ---
DATABASE_URL="postgresql://memora:memora@localhost:5432/memora?schema=public"

# --- Cache et files d'attente ---
REDIS_URL="redis://localhost:6379"

# --- Stockage objet (MinIO, compatible S3) ---
S3_ENDPOINT="http://localhost:9000"
S3_REGION="eu-west-3"
S3_BUCKET="memora-photos"
S3_ACCESS_KEY="memora"
S3_SECRET_KEY="memora-secret"

# --- Authentification ---
JWT_ACCESS_SECRET="change-moi-en-production"
JWT_REFRESH_SECRET="change-moi-aussi"
GUEST_SESSION_SECRET="et-moi-aussi"

# --- Paiement V2 (facultatif en V1) ---
STRIPE_SECRET_KEY="sk_test_xxx"
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# --- Notifications facultatives ---
# Web Push (PWA / navigateur)
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:contact@memora.app"

# Notifications iOS natives (APNs)
APNS_KEY_ID=""
APNS_TEAM_ID=""
APNS_PRIVATE_KEY=""
APNS_TOPIC="fr.memora-app.client"
APNS_SANDBOX="true"

# --- Serveur ---
PORT=3000
CLIENT_URL="http://localhost:5173"
