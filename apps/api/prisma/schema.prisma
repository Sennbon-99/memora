// 🗄️ apps/api/prisma/schema.prisma
// Traduction du modele logique du dossier (partie 2.2.1.c) en schema Prisma.
// Convention de nommage : modeles et champs en anglais, commentaires en francais.
// Chaque entite du MCD francais a son equivalent ici : EVENEMENT -> Event,
// PELLICULE -> Roll, PHOTO -> Photo, TABLE_SALLE -> EventTable,
// DEMANDE_RETRAIT -> RemovalRequest.

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Enumerations : memes valeurs que packages/types/src/enums.ts ------------

enum EventType   { MARIAGE ANNIVERSAIRE ENTREPRISE }
enum EventState  { DRAFT OPEN CLOSED PUBLISHED PURGED }
enum PreviewMode { NONE FLASH BLURRED CONFIRM }
enum Scope       { NONE EVERYONE SELECTED OWN_ONLY }
enum PhotoStatus { RESERVED UPLOADED HIDDEN REMOVED }
enum UserRole    { HOST ADMIN }
enum RequestState{ PENDING ACCEPTED REFUSED }
enum PaymentState{ PENDING PAID FAILED }

// --- L'hote et ses co-hotes --------------------------------------------------

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         UserRole  @default(HOST)
  createdAt    DateTime  @default(now())

  ownedEvents  Event[]   @relation("EventOwner")
  coHostOf     CoHost[]

  @@map("users")
}

/// Table d'association : un utilisateur peut co-animer plusieurs evenements,
/// un evenement peut avoir plusieurs co-hotes. C'est l'association
/// plusieurs-a-plusieurs du MCD, devenue une relation propre au MLD.
model CoHost {
  userId    String
  eventId   String
  invitedAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@map("co_hosts")
}

// --- L'evenement, pivot du modele --------------------------------------------

model Event {
  id             String      @id @default(cuid())
  name           String      @db.VarChar(120)
  /// Identifiant public, celui qui figure dans l'URL du QR code.
  slug           String      @unique @db.VarChar(64)
  type           EventType
  eventDate      DateTime    @db.Timestamptz
  quotaShots     Int         @db.SmallInt
  /// Heure a laquelle la prise de vue s'arrete. Fait foi, fuseau compris.
  closesAt       DateTime    @db.Timestamptz
  previewMode    PreviewMode @default(NONE)
  color          String      @db.Char(7)
  logoKey        String?
  welcomeMessage String?     @db.VarChar(280)
  useTableCodes  Boolean     @default(false)
  state          EventState  @default(DRAFT)
  scope          Scope       @default(NONE)
  /// Jeton du lien d'album, distinct de l'identifiant : revocable, non devinable.
  albumToken     String?     @unique
  accessCodeHash String?
  createdAt      DateTime    @default(now())

  ownerId        String
  owner          User        @relation("EventOwner", fields: [ownerId], references: [id])
  coHosts        CoHost[]
  rolls          Roll[]
  tables         EventTable[]
  moments        Moment[]
  payment        Payment?

  /// Index de la tache planifiee qui ferme les evenements arrives a echeance.
  @@index([state, closesAt])
  @@map("events")
}

/// Une table de la salle. Sert a segmenter les contributions quand l'hote
/// choisit d'imprimer un QR code par table plutot qu'un seul a l'entree.
model EventTable {
  id       String @id @default(cuid())
  label    String @db.VarChar(40)
  qrToken  String @unique

  eventId  String
  event    Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  rolls    Roll[]

  @@map("event_tables")
}

// --- La pellicule : un appareil, pour un evenement ---------------------------

/// Represente l'appareil d'un invite, non l'invite lui-meme.
/// C'est elle qui porte le quota et le consentement.
model Roll {
  id            String    @id @default(cuid())
  /// Identifiant signe depose dans le cookie de l'appareil.
  deviceToken   String
  firstName     String?   @db.VarChar(30)
  /// Horodatage du consentement. Nul tant qu'il n'a pas ete donne :
  /// aucune photographie ne peut exister avant.
  consentedAt   DateTime? @db.Timestamptz
  shotsLeft     Int       @db.SmallInt
  /// Poses supplementaires d'un moment fort, perdues a sa fermeture.
  bonusShots    Int       @default(0) @db.SmallInt
  recoveryHash  String?
  createdAt     DateTime  @default(now())

  eventId       String
  event         Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tableId       String?
  table         EventTable? @relation(fields: [tableId], references: [id], onDelete: SetNull)
  photos        Photo[]
  requests      RemovalRequest[]

  /// Un meme appareil ne peut pas ouvrir deux pellicules sur le meme evenement.
  @@unique([eventId, deviceToken])
  @@map("rolls")
}

// --- Les photographies -------------------------------------------------------

model Photo {
  id             String      @id @default(cuid())
  /// Chemin de l'objet dans le stockage : evenement/pellicule/uuid.jpg
  objectKey      String      @unique
  /// Cle fournie par le client. Un rejeu retrouve la photo au lieu d'en creer une.
  idempotencyKey String      @unique
  takenAt        DateTime    @db.Timestamptz
  uploadedAt     DateTime?   @db.Timestamptz
  status         PhotoStatus @default(RESERVED)
  published      Boolean     @default(false)
  width          Int
  height         Int
  sizeBytes      Int

  rollId         String
  roll           Roll        @relation(fields: [rollId], references: [id], onDelete: Cascade)
  /// Une photographie peut n'appartenir a aucun moment fort.
  momentId       String?
  moment         Moment?     @relation(fields: [momentId], references: [id], onDelete: SetNull)
  requests       RemovalRequest[]

  @@index([rollId, status])
  @@map("photos")
}

// --- Les moments forts -------------------------------------------------------

model Moment {
  id              String    @id @default(cuid())
  label           String    @db.VarChar(60)
  plannedAt       DateTime? @db.Timestamptz
  /// Renseigne au declenchement reel, qui peut differer de l'heure prevue.
  startedAt       DateTime? @db.Timestamptz
  durationMinutes Int       @db.SmallInt
  bonusShots      Int       @db.SmallInt

  eventId         String
  event           Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  photos          Photo[]

  @@map("moments")
}

// --- Droit a l'image ---------------------------------------------------------

/// Demande de retrait formulee par un invite sur une photographie ou il apparait.
/// Le masquage est immediat, l'arbitrage revient a l'hote.
model RemovalRequest {
  id          String       @id @default(cuid())
  reason      String       @db.VarChar(280)
  state       RequestState @default(PENDING)
  createdAt   DateTime     @default(now())
  handledAt   DateTime?

  photoId     String
  photo       Photo        @relation(fields: [photoId], references: [id], onDelete: Cascade)
  /// La pellicule du demandeur, pour lui repondre sans connaitre son identite.
  rollId      String
  roll        Roll         @relation(fields: [rollId], references: [id], onDelete: Cascade)

  @@map("removal_requests")
}

// --- Paiement ----------------------------------------------------------------

model Payment {
  id           String       @id @default(cuid())
  amountCents  Int
  state        PaymentState @default(PENDING)
  /// Identifiant de la session Stripe, sert aussi de cle d'idempotence.
  externalRef  String       @unique
  paidAt       DateTime?

  eventId      String       @unique
  event        Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@map("payments")
}
