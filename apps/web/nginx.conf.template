# apps/web/nginx.conf.template
# Le client et l'API sont servis sous la meme origine.
#
# Ce n'est pas un detail de confort : les cookies d'appareil et de session
# sont poses en SameSite, et le navigateur ne les enverrait pas vers une
# autre origine. Le proxy evite aussi toute configuration CORS, et le code
# du client reste identique en developpement, ou Vite fait la meme chose.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # En-tetes de securite du client.
    #
    # Helmet ne protege que l'API : le client, lui, est servi par nginx, qui
    # ne posait rien. La page que charge reellement un navigateur etait donc
    # cadrable dans une iframe et sujette au reniflement de type MIME, alors
    # que l'interface de programmation derriere elle etait, elle, protegee.
    #
    # always : sans ce mot-cle, nginx omet l'en-tete sur les reponses 4xx et
    # 5xx — exactement celles qu'un attaquant cherche a provoquer.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), payment=()" always;

    # La camera est la seule permission que le produit demande, et seulement
    # depuis sa propre origine. Les images viennent du stockage objet, les
    # connexions aussi. data: est necessaire aux apercus produits par le
    # canvas avant envoi, blob: aux fichiers mis en file d'attente hors ligne.
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob: https:; media-src 'self' blob:; connect-src 'self' https: wss:; style-src 'self' 'unsafe-inline'; font-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;

    # Compression : le paquet JavaScript pese environ 500 Ko, et la salle
    # des fetes n'a pas la fibre.
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # Les fichiers produits portent une empreinte dans leur nom : ils ne
    # changent jamais sans changer d'adresse, on peut donc les garder un an.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        # nginx n'herite pas les en-tetes du bloc parent des qu'un
        # add_header apparait ici : il faut donc les repeter, sinon les
        # fichiers servis par ce bloc partiraient sans protection.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    # Le service worker, lui, ne doit jamais etre garde en cache : c'est lui
    # qui decide quand le reste est renouvele.
    location = /sw.js {
        add_header Cache-Control "no-cache, no-store, must-revalidate";
        # nginx n'herite pas les en-tetes du bloc parent des qu'un
        # add_header apparait ici : il faut donc les repeter, sinon les
        # fichiers servis par ce bloc partiraient sans protection.
        add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "DENY" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        try_files $uri =404;
    }

    location /api/ {
        # Le nom de l'API est resolu a chaque requete, et non une seule fois
        # au demarrage. Sans cette precaution, nginx refuse de demarrer si
        # l'API n'est pas encore la — et un redeploiement de l'API, qui lui
        # donne un nouveau conteneur, laisserait le client pointer dans le
        # vide jusqu'a son propre redemarrage.
        resolver 127.0.0.11 valid=10s ipv6=off;
        set $amont ${API_UPSTREAM};
        proxy_pass $amont;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Socket.io passe par la : sans ces deux en-tetes, la connexion
        # retomberait en interrogation reguliere et les moments forts
        # arriveraient avec du retard.
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        # Le depot d'une photographie peut etre long sur un reseau sature.
        proxy_read_timeout 120s;
        client_max_body_size 25m;
    }

    # Application a page unique : toute adresse inconnue rend index.html,
    # et c'est le routeur du client qui decide quoi afficher.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
